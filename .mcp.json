{
  "mcpServers": {
    "atlassian-jira": {
      "command": "mcp-atlassian-jira",
      "args": [],
      "env": {
        "ATLASSIAN_SITE_NAME": "caremetx",
        "ATLASSIAN_USER_EMAIL": "{env:JIRA_USERNAME}",
        "ATLASSIAN_API_TOKEN": "{env:JIRA_API_TOKEN}",
        "DT_ENVIRONMENT": "https://jop65683.apps.dynatrace.com"
      },
      "description": "Jira operations \u2014 issues, sprints, boards, JQL search",
      "triggerKeywords": [
        "jira",
        "ticket",
        "sprint",
        "backlog",
        "board",
        "jql",
        "story",
        "epic",
        "kanban",
        "scrum",
        "assignee",
        "blocker",
        "bug report",
        "user story",
        "acceptance criteria",
        "story points",
        "velocity",
        "standup",
        "retrospective"
      ],
      "autoActivate": false
    },
    "atlassian-confluence": {
      "command": "mcp-atlassian-confluence",
      "args": [],
      "env": {
        "ATLASSIAN_SITE_NAME": "caremetx",
        "ATLASSIAN_USER_EMAIL": "akaempf@caremetx.com",
        "ATLASSIAN_API_TOKEN": "{env:CONFLUENCE_API_TOKEN}"
      },
      "description": "Confluence operations \u2014 pages, spaces, search, content",
      "triggerKeywords": [
        "confluence",
        "wiki",
        "knowledge base",
        "runbook",
        "playbook",
        "postmortem",
        "design doc",
        "technical spec",
        "team page"
      ],
      "autoActivate": false
    },
    "github": {
      "command": "mcp-server-github",
      "args": [],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "description": "GitHub operations \u2014 repos, issues, PRs, code search",
      "triggerKeywords": [
        "github",
        "pull request",
        "pr review",
        "github repo",
        "github repository",
        "merge request",
        "git issue",
        "code review",
        "github actions",
        "workflow run",
        "github release"
      ],
      "autoActivate": false
    },
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": ["/Users/akaempf", "/Volumes/DasWork"],
      "env": {
        "HOME": "/Users/akaempf"
      },
      "description": "Filesystem operations — move, rename, copy, directory trees, file metadata",
      "triggerKeywords": [
        "move file",
        "rename file",
        "copy file",
        "duplicate file",
        "move folder",
        "rename folder",
        "directory tree",
        "file tree",
        "folder tree",
        "file size",
        "file metadata",
        "file info",
        "disk usage",
        "create directory",
        "create folder",
        "DasWork",
        "/Volumes"
      ],
      "autoActivate": false
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "description": "Library and framework documentation — version-accurate API references",
      "triggerKeywords": [
        "context7",
        "library docs",
        "api reference",
        "framework docs",
        "documentation for",
        "docs for",
        "how do i use",
        "how to use",
        "example for",
        "syntax for",
        "show me how",
        "next.js",
        "express docs",
        "fastapi docs",
        "django docs",
        "flask docs",
        "vue docs",
        "angular docs",
        "svelte docs",
        "tailwind docs",
        "prisma docs",
        "drizzle docs",
        "supabase docs",
        "react docs",
        "typescript docs",
        "python docs"
      ],
      "excludeTools": ["WebSearch", "exa-websearch", "WebFetch"],
      "autoActivate": false
    },
    "dynatrace": {
      "command": "mcp-server-dynatrace",
      "args": [],
      "env": {
        "DT_ENVIRONMENT": "https://jop65683.apps.dynatrace.com"
      },
      "description": "Dynatrace observability \u2014 problems, DQL queries, Davis AI",
      "triggerKeywords": [
        "dynatrace",
        "davis ai",
        "dql query",
        "synthetic monitor",
        "anomaly detection",
        "service flow",
        "distributed trace",
        "log analytics"
      ],
      "includeTools": [
        "execute_dql",
        "list_problems",
        "find_entity_by_name",
        "list_vulnerabilities",
        "list_exceptions",
        "generate_dql_from_natural_language"
      ],
      "autoActivate": false,
      "keepAlive": true
    }
  }
}