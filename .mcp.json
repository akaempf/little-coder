{
  "excludeServers": ["sqz"],
  "mcpServers": {
    "github": {
      "command": "mcp-server-github",
      "args": [],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "{env:GITHUB_TOKEN}"
      },
      "description": "GitHub operations \u2014 repos, issues, PRs, code search",
      "triggerKeywords": [
        "github",
        "pull request",
        "pr review",
        "github repo",
        "github repository",
        "merge request",
        "git issue",
        "code review",
        "github actions",
        "workflow run",
        "github release"
      ],
      "includeTools": [
        "get_file_contents",
        "search_code",
        "create_issue",
        "create_pull_request",
        "list_issues",
        "get_pull_request",
        "search_repositories"
      ],
      "autoActivate": false
    },
    "filesystem": {
      "command": "mcp-server-filesystem",
      "args": [
        "/Users/akaempf",
        "/Volumes/DasWork"
      ],
      "env": {
        "HOME": "/Users/akaempf"
      },
      "description": "Filesystem operations \u2014 move, rename, copy, directory trees, file metadata",
      "triggerKeywords": [
        "move file",
        "rename file",
        "copy file",
        "duplicate file",
        "move folder",
        "rename folder",
        "directory tree",
        "file tree",
        "folder tree",
        "file size",
        "file metadata",
        "file info",
        "disk usage",
        "create directory",
        "create folder",
        "DasWork",
        "/Volumes"
      ],
      "includeTools": [
        "read_file",
        "write_file",
        "edit_file",
        "list_directory",
        "search_files",
        "directory_tree"
      ],
      "autoActivate": false
    },
    "context7": {
      "url": "https://mcp.context7.com/mcp",
      "description": "Library and framework documentation \u2014 version-accurate API references",
      "triggerKeywords": [
        "context7",
        "library docs",
        "api reference",
        "framework docs",
        "documentation for",
        "docs for",
        "how do i use",
        "how to use",
        "example for",
        "syntax for",
        "show me how",
        "next.js",
        "express docs",
        "fastapi docs",
        "django docs",
        "flask docs",
        "vue docs",
        "angular docs",
        "svelte docs",
        "tailwind docs",
        "prisma docs",
        "drizzle docs",
        "supabase docs",
        "react docs",
        "typescript docs",
        "python docs"
      ],
      "excludeTools": [
        "WebSearch",
        "exa-websearch",
        "WebFetch"
      ],
      "autoActivate": false
    },
    "aws-api": {
      "command": "/Users/akaempf/.local/venvs/aws-api-mcp/bin/python3.13",
      "args": [
        "-m",
        "awslabs.aws_api_mcp_server.server"
      ],
      "env": {
        "AWS_PROFILE": "sso-sha106",
        "AWS_REGION": "us-east-1",
        "PYTHONPATH": "",
        "HOME": "/Users/akaempf"
      },
      "description": "AWS API \u2014 query and manage AWS resources via the CLI/API (S3, EC2, Lambda, IAM, RDS, ECS, CloudWatch, etc.)",
      "triggerKeywords": [
        "aws",
        "s3",
        "ec2",
        "lambda",
        "iam",
        "cloudformation",
        "cloudwatch",
        "rds",
        "dynamodb",
        "ecs",
        "eks",
        "sqs",
        "sns",
        "kinesis",
        "route53",
        "vpc",
        "elb",
        "alb",
        "api gateway",
        "secrets manager",
        "ssm parameter",
        "aws api",
        "aws cli",
        "boto3"
      ],
      "autoActivate": false
    },
    "engram": {
      "command": "engram",
      "args": ["mcp"],
      "description": "structured memory — SQLite+FTS5 observations, sessions, timeline",
      "triggerKeywords": [
        "save-session",
        "save session",
        "session-summary",
        "note to self",
        "decision log",
        "learning log",
        "remember this",
        "recall",
